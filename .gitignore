# Environment variable files
.env
.env.*

# Virtual environment directories
venv/
.venv/
env/
ENV/

# Ignore any "final_artifacts" subfolder anywhere in the repo
**/final_artifacts/

# Ignore common media and markdown files inside any final_artifacts folder
**/final_artifacts/**/*.jpg
**/final_artifacts/**/*.webm
**/final_artifacts/**/*.mp4
**/final_artifacts/**/*.md

# Python cache and build artifacts
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/

# Logs and runtime test outputs
*.log
**/workspace/output/*
!**/workspace/output/.gitkeep
**/workspace/temp/*
!**/workspace/temp/.gitkeep
**/test-artifacts/

# OS and Office lock files
.DS_Store
Thumbs.db
~$*

# Ignored untracked projects on dev branch
V0008_Compare_Alignments_Strengths_Weaknesses_of_Chatbots/
